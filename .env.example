# Copia este archivo a .env.local (nunca se sube a Git).
# Solo valores PÚBLICOS: la clave anon/publishable es segura en el cliente.
# NUNCA pongas aquí una clave service_role ni contraseñas.

# Entorno explícito: "local" o "production"
VITE_APP_ENV=local

# Supabase local (valores que imprime `npm run db:start`, también `npx supabase status`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Pruebas E2E con el usuario demo local (ver README). Déjalas vacías en producción.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Producción: se configuran en el servicio de hosting, no en este archivo.
